{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_server_requests_seconds_bucket{application=\"docmind-backend\"}[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{application=\"docmind-backend\"}[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{application=\"docmind-backend\"}[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Cache Hit Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "docmind_cache_hits_total / (docmind_cache_hits_total + docmind_cache_misses_total) * 100",
          "legendFormat": "Hit Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "green", "value": 60 }
            ]
          }
        }
      }
    },
    {
      "title": "Cache Hits vs Misses (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(docmind_cache_hits_total[5m])",
          "legendFormat": "Hits/s",
          "refId": "A"
        },
        {
          "expr": "rate(docmind_cache_misses_total[5m])",
          "legendFormat": "Misses/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 }
        }
      }
    },
    {
      "title": "Retrieval Strategy Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "docmind_queries_vector_only_total",
          "legendFormat": "Vector-only",
          "refId": "A"
        },
        {
          "expr": "docmind_queries_hybrid_total",
          "legendFormat": "Hybrid",
          "refId": "B"
        },
        {
          "expr": "docmind_queries_hybrid_rerank_total",
          "legendFormat": "Hybrid+Rerank",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Error Rate by Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{status=~\"5..\", application=\"docmind-backend\"}[5m])",
          "legendFormat": "5xx {{uri}}",
          "refId": "A"
        },
        {
          "expr": "rate(http_server_requests_seconds_count{status=~\"4..\", application=\"docmind-backend\"}[5m])",
          "legendFormat": "4xx {{uri}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 }
        }
      }
    },
    {
      "title": "Async Processing Queue Depth",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "docmind_async_queue_active_count",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "docmind_async_queue_size",
          "legendFormat": "Queued",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "red", "value": 45 }
            ]
          }
        }
      }
    },
    {
      "title": "Requests per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"docmind-backend\"}[5m])) by (uri)",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 50 }
        }
      }
    },
    {
      "title": "Estimated Cost (cents/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "rate(docmind_llm_tokens_total[5m]) * 0.0015",
          "legendFormat": "LLM cost",
          "refId": "A"
        },
        {
          "expr": "rate(docmind_embedding_tokens_total[5m]) * 0.00002",
          "legendFormat": "Embedding cost",
          "refId": "B"
        },
        {
          "expr": "rate(docmind_rerank_calls_total[5m]) * 0.1",
          "legendFormat": "Rerank cost",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 30 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["docmind", "rag", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "DocMind Backend",
  "uid": "docmind-backend",
  "version": 1
}
