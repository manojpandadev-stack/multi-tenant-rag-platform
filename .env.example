# ============================================================
# DocMind Pro — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Required for running the full application.
# Tests run WITHOUT API keys (using NoOpEmbeddingModel).
# ============================================================

# --- Database (PostgreSQL + pgvector) ---
# Host port 5433 (5432 is reserved by the intellimove project's Postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=docmind
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind

# --- JWT Authentication ---
# Must be at least 256 bits (32 bytes) for HS256
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-use-at-least-256-bits-for-HS256

# --- LLM Provider (Groq primary, OpenAI fallback) ---
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Reranking (Cohere) ---
# Optional — only needed if using HYBRID_RERANK retrieval strategy
COHERE_API_KEY=

# --- Observability ---
# Optional — only needed if running full observability stack (docker-compose)
# Spring Boot 3.3 OTLP HTTP tracing endpoint (default: localhost:4318/v1/traces).
# docker-compose overrides this for the in-container value (http://jaeger:4318/v1/traces).
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
